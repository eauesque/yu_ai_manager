{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-config-schema/schema.json",
  "productName": "YU AI Manager",
  "version": "4.26.0",
  "identifier": "com.yu-ai-manager.desktop",
  "build": {
    "frontendDist": "./frontend",
    "devUrl": "http://localhost:5100/tauri-shell"
  },
  "app": {
    "windows": [
      {
        "title": "YU AI Manager",
        "width": 1280,
        "height": 860,
        "minWidth": 800,
        "minHeight": 600,
        "center": true,
        "decorations": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self' http://127.0.0.1:*; script-src 'self' 'unsafe-inline' http://127.0.0.1:*; style-src 'self' 'unsafe-inline' http://127.0.0.1:*; img-src 'self' http://127.0.0.1:* data: blob:; connect-src 'self' http://127.0.0.1:* ws://127.0.0.1:*; media-src 'self' http://127.0.0.1:* yufile:; font-src 'self' http://127.0.0.1:* data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": {
      "bundle.zip": "bundle.zip",
      "yu-server.exe": "yu-server.exe"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  },
  "plugins": {
    "shell": {
      "open": true
    },
    "updater": {
      "endpoints": [
        "https://github.com/eauesque/yu_ai_manager/releases/latest/download/latest.json"
      ],
      "pubkey": ""
    }
  }
}
