# yu-server environment — copy to ~/.config/yu/server.env and fill in values
#
#   cp deploy/server.env.example ~/.config/yu/server.env
#   chmod 600 ~/.config/yu/server.env   # db_key is sensitive

YU_DB=/path/to/tags.db
# Generate with:  openssl rand -hex 32
# Hex only, on purpose: the Python side rejects a key containing whitespace or
# any of ' " ; \ & , } ] (core/services_core/db_cipher.py), and it is the
# Python side that migrates this database. A key this binary accepts but the
# migrator refuses is a database that can never be migrated.
#
# Generating your own key also means standalone only: the Python *server*
# reads no key from the environment (core/services_core/db_cipher.py opens
# every connection with its built-in one), so a deployment that sets
# YU_PYTHON_URL has a backend that cannot open this database. yu-server
# detects that and stops treating Python as a migrator. Only the migration
# CLI takes YU_DB_KEY.
#
# Migrating an existing desktop install is the other case entirely: that
# database is already encrypted with the built-in key, so a generated one
# would not open it. scripts/migrate_launch_args.py writes the built-in key
# for exactly that reason -- keep what it wrote.
YU_DB_KEY=REPLACE_WITH_A_GENERATED_SECRET

# Uncomment to allow LAN access (requires YU_PIN)
#YU_HOST=0.0.0.0
#YU_PORT=5000
#YU_PIN=your-pin-here

# Python fallback proxy (leave empty to disable)
#
# Uncommenting this also declares "a Python backend is running and owns the
# schema migration chain". That changes how a stale database is handled:
# instead of refusing to start (exit 78), yu-server warns once and serves,
# trusting Python to migrate it. Leave it commented unless a Python backend
# really is there -- otherwise a database older than the binary is served with
# tables this build expects missing, and queries come back empty.
#YU_PYTHON_URL=http://127.0.0.1:5001

# Config JSON path (scan_roots etc.)
#YU_CONFIG=/path/to/config.json
