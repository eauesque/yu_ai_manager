{
  "$schema": "https://opencode.ai/config.json",
  "model": "llama.cpp/ornith-ai/Ornith-1.5-9B-GGUF",
  "provider": {
    "llama.cpp": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "llama.cpp (local Ornith)",
      "options": {
        "baseURL": "http://127.0.0.1:8000/v1"
      },
      "models": {
        "ornith-ai/Ornith-1.5-9B-GGUF": {
          "name": "Ornith 1.5 9B (local)",
          "limit": {
            "context": 32768,
            "output": 8192
          }
        }
      }
    }
  },
  "mcp": {
    "ai-coreutils": {
      "type": "local",
      "command": ["yu", "mcp", "serve", "--legacy"],
      "timeout": 30000
    },
    "codex": {
      "type": "local",
      "command": ["codex", "mcp-server"]
    },
    "github": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-github"],
      "environment": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "{env:GITHUB_PERSONAL_ACCESS_TOKEN}"
      }
    },
    "memory": {
      "type": "local",
      "command": ["memory-server", "mcp"],
      "timeout": 30000
    },
    "retrieval": {
      "type": "remote",
      "url": "http://127.0.0.1:9999/retrieval/mcp",
      "timeout": 300000
    }
  },
  "permission": {
    "edit": "deny",
    "bash": "deny"
  },
  "skills": {
    "paths": ["{env:HOME}/.codex/skills"]
  }
}
