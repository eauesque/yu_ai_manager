{
  "name": "yu-ai-manager",
  "version": "4.689.41",
  "private": true,
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "clean": "node -e \"require('fs').rmSync('ui/default/static/dist',{recursive:true,force:true})\"",
    "rebuild": "pnpm run clean && pnpm run build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src e2e",
    "test": "vitest run"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@modelcontextprotocol/server-filesystem": "2026.7.10",
    "@playwright/test": "^1.60.0",
    "@types/node": "^25.7.0",
    "@types/qrcode": "^1.5.6",
    "esbuild": "^0.28.1",
    "eslint": "^10.9.1",
    "jsdom": "^29.1.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@node-rs/jieba": "^2.0.1",
    "dictionary-en": "^4.0.0",
    "dompurify": "^3.4.13",
    "highlight.js": "^11.11.1",
    "jsqr": "^1.4.0",
    "marked": "^18.0.3",
    "nspell": "^2.1.5",
    "qrcode": "^1.5.4",
    "tiny-segmenter": "^0.2.0"
  }
}
